# VisitLink Environment Variables Configuration

# 1. Supabase Local Configuration (Default ports for `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0NjA4MDB9.CRXP_demo_anon_key_for_local_development_only
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzQ2MDgwMH0.CRXP_demo_service_role_key_for_local_only
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# 2. Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FASTAPI_SERVICE_URL=http://localhost:8000

# 3. AI Service Configuration
# Swappable provider: 'gemini', 'openai', or 'mock' (for offline zero-key dev)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# 4. Email / Notifications (Local Mailpit by default)
EMAIL_PROVIDER=mailpit # 'mailpit' or 'resend'
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@visitlink.local

# 5. Visit Logistics & External Routing Providers
# Swappable providers: 'openrouteservice', 'mock' (deterministic Coimbatore speed-profile), or 'osrm_demo'
ROUTING_PROVIDER=openrouteservice
ORS_API_KEY= # Free tier from https://openrouteservice.org/ (2,000 directions/day, 40 req/min)
# Open-Meteo Weather requires no API key (free tier up to 10,000 calls/day, CC BY 4.0 attribution)
